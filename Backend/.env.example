NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

DB_HOST=localhost
DB_PORT=3306
DB_NAME=iot
DB_USER=root
DB_PASSWORD=change-me
DB_SYNC=safe

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

MQTT_ENABLED=true
# Backend process -> Mosquitto on the same development machine
MQTT_URL=mqtt://localhost:1883
# ESP32 -> Mosquitto over LAN. Replace with the computer's actual LAN IP.
MQTT_DEVICE_URL=mqtt://192.168.1.10:1883
MQTT_USERNAME=agri_backend
MQTT_PASSWORD=change-me
MQTT_TOPIC_PREFIX=iot
MQTT_FIRMWARE_TOPIC_PREFIX=sf

# Enable after Mosquitto Dynamic Security plugin has been initialized.
# MQTT DYNSEC ENABLE là bật cái ACL của MQTT
MQTT_DYNSEC_ENABLED=false
MQTT_DYNSEC_ADMIN_USERNAME=iot_dynsec_admin
MQTT_DYNSEC_ADMIN_PASSWORD=change-me
MQTT_DYNSEC_REQUEST_TIMEOUT_MS=8000

HEARTBEAT_SWEEP_SEC=10
COMMAND_ACK_TIMEOUT_SEC=15
DEVICE_PROBE_TIMEOUT_SEC=8

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisPassword123!

# External AI API used by Backend after image upload. Set private values in Backend/.env.
AI_API_URL=
AI_API_KEY=
AI_REQUEST_TIMEOUT_MS=60000

# Cloudinary: ảnh Camera được lưu trên Cloudinary, DB lưu secure_url/public_id/hash
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=smart-agri/camera-media
