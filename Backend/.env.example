# Copy to .env and set values appropriate for your environment.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=iot
DB_USER=root
DB_PASSWORD=change-me
# DB_PASS is accepted for compatibility with older local .env files.
DB_SYNC=safe

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

MQTT_ENABLED=true
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=iot

HEARTBEAT_SWEEP_SEC=10
COMMAND_ACK_TIMEOUT_SEC=15

# Dịch vụ AI publish kết quả + ảnh Base64 tới {MQTT_TOPIC_PREFIX}/ai/result.
AI_MIN_CONFIDENCE=0.5
# Kích thước ảnh gốc tối đa (5 MiB). Chỉ hỗ trợ JPEG, PNG, WebP.
AI_IMAGE_MAX_BYTES=5242880
# Thư mục local lưu ảnh; hãy dùng ổ đĩa/volume có backup và đủ dung lượng.
AI_IMAGE_STORAGE_DIR=storage/analysis-images

# Optional initial administrator bootstrap; use a strong one-time password.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator
BOOTSTRAP_ADMIN_PASSWORD=
